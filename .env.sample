MONGO_DB_USERNAME=
MONGO_DB_PASSWORD=
MONGO_DB_NAME=
MONGO_DB_PORT=
MONGO_DB_HOST=
APP_PORT=7506

# Which interface to accept connections on. Unset = all interfaces (the
# default, and what Docker needs: other containers reach this service over the
# compose network by hostname). If every client shares one host, set
# 127.0.0.1 to take the service off the network entirely — it authenticates
# callers by API key/secret only, with no rate limiting behind it.
# APP_HOST=127.0.0.1
EXCHANGE_SERVICE_API_URL=http://localhost:7507
REDIS_PORT=
REDIS_PASSWORD=

# Comma-separated symbols (e.g. BTCUSDT,ETHUSDT) whose fee is reported as
# paid in a third asset (PAPER_FEE_ASSET, default GNM) instead of split onto
# feeSide base/quote — for testing against a genuine BNB/BGB/KCS-style
# discount-asset account without one. The charged amount is unchanged.
# PAPER_FEE_ASSET_SYMBOLS=
# PAPER_FEE_ASSET=GNM